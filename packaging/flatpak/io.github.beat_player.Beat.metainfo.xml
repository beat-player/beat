<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.beat_player.Beat</id>
  <name>beat</name>
  <summary>A small, fast music player for your local library</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <developer id="io.github.beat_player">
    <name>beat</name>
  </developer>
  <description>
    <p>
      beat plays the music in a folder on your computer. It scans the folder in the background,
      shows albums and covers as they are found, and keeps the whole library in one small,
      fast application.
    </p>
    <ul>
      <li>Albums, artists, playlists and tags, with smart playlists made from tags</li>
      <li>A five-band equalizer and a live spectrum</li>
      <li>Last.fm scrobbling</li>
      <li>Plugins written in Lua</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.beat_player.Beat.desktop</launchable>
  <url type="homepage">https://github.com/beat-player/beat</url>
  <url type="bugtracker">https://github.com/beat-player/beat/issues</url>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/beat-player/beat/master/docs/screenshots/home.png</image>
      <caption>The home screen</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <requires>
    <display_length compare="ge">640</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
</component>
